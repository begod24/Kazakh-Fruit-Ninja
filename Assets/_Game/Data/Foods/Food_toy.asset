  id: toy
  nameKk: "\u0422\u043E\u0439"
  nameRu: "\u0422\u043E\u0439"
  nameEn: Toi feast
  factRu: "\u0422\u043E\u0439 \u2014 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A:
    \u0433\u043E\u0441\u0442\u0435\u0439 \u043E\u0441\u044B\u043F\u0430\u044E\u0442
    \u0448\u0430\u0448\u0443 \u2014 \u043A\u043E\u043D\u0444\u0435\u0442\u0430\u043C\u0438
    \u0438 \u043C\u043E\u043D\u0435\u0442\u0430\u043C\u0438 \u043D\u0430 \u0441\u0447\u0430\u0441\u0442\u044C\u0435."
  factKk: "\u0422\u043E\u0439 \u2014 \u043C\u0435\u0440\u0435\u043A\u0435: \u049B\u043E\u043D\u0430\u049B\u0442\u0430\u0440\u0434\u044B\u04A3
    \u0431\u0430\u0441\u044B\u043D\u0430 \u0431\u0430\u049B\u044B\u0442 \u0442\u0456\u043B\u0435\u043F
    \u0448\u0430\u0448\u0443 \u2014 \u043A\u04D9\u043C\u043F\u0438\u0442 \u043F\u0435\u043D
    \u0442\u0438\u044B\u043D \u0448\u0430\u0448\u0430\u0434\u044B."
  factEn: "A toi is a celebration: guests are showered with shashu \u2014 sweets
    and coins for good luck."
