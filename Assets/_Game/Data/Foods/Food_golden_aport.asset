  id: golden_aport
  nameKk: "\u0410\u043B\u0442\u044B\u043D \u0430\u043F\u043E\u0440\u0442"
  nameRu: "\u0417\u043E\u043B\u043E\u0442\u043E\u0439 \u0430\u043F\u043E\u0440\u0442"
  nameEn: Golden aport
  factRu: "\u0411\u0435\u0439, \u043F\u043E\u043A\u0430 \u0432\u0438\u0441\u0438\u0442:
    \u043A\u0430\u0436\u0434\u044B\u0439 \u0443\u0434\u0430\u0440 \u2014 \u043E\u0447\u043A\u043E,
    \u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0440\u0430\u0441\u043A\u043E\u043B\u0435\u0442
    \u0435\u0433\u043E \u043F\u043E\u043F\u043E\u043B\u0430\u043C."
  factKk: "\u0406\u043B\u0443\u043B\u0456 \u0442\u04B1\u0440\u0493\u0430\u043D\u0434\u0430
    \u043A\u0435\u0441\u0435 \u0431\u0435\u0440: \u04D9\u0440 \u0441\u043E\u049B\u049B\u044B
    \u2014 \u0431\u0456\u0440 \u04B1\u043F\u0430\u0439, \u0441\u043E\u04A3\u0493\u044B\u0441\u044B
    \u043E\u043D\u044B \u0435\u043A\u0456\u0433\u0435 \u0431\u04E9\u043B\u0435\u0434\u0456."
  factEn: 'Keep striking while it hangs: every hit scores a point, and the last one
    splits it in two.'
