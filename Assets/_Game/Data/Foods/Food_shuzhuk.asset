  nameKk: "\u0428\u04B1\u0436\u044B\u049B"
  nameRu: "\u0428\u0443\u0436\u0443\u043A"
  nameEn: Shuzhuk
  factRu: "\u0414\u043E\u043C\u0430\u0448\u043D\u044F\u044F \u043A\u043E\u043B\u0431\u0430\u0441\u0430
    \u0438\u0437 \u043A\u043E\u043D\u0438\u043D\u044B \u0441 \u0447\u0435\u0441\u043D\u043E\u043A\u043E\u043C
    \u0438 \u0441\u043F\u0435\u0446\u0438\u044F\u043C\u0438; \u0435\u0451 \u0437\u0430\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0442
    \u0437\u0438\u043C\u043E\u0439, \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0441\u043E\u0493\u044B\u043C\u0430."
  factKk: "\u0416\u044B\u043B\u049B\u044B \u0435\u0442\u0456\u043D\u0435\u043D \u0441\u0430\u0440\u044B\u043C\u0441\u0430\u049B
    \u043F\u0435\u043D \u0434\u04D9\u043C\u0434\u0435\u0443\u0456\u0448 \u049B\u043E\u0441\u044B\u043F
    \u0436\u0430\u0441\u0430\u0439\u0442\u044B\u043D \u04AF\u0439 \u0448\u04B1\u0436\u044B\u0493\u044B;
    \u043E\u043D\u044B \u049B\u044B\u0441\u0442\u0430, \u0441\u043E\u0493\u044B\u043C
    \u043A\u0435\u0437\u0456\u043D\u0434\u0435 \u04D9\u0437\u0456\u0440\u043B\u0435\u0439\u0434\u0456."
  factEn: "Homemade horse-meat sausage with garlic and spices, made in winter, in
    the so\u011Fym season."
